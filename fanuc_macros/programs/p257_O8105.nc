O8105 (ARC HOLE PATTERN MACRO)
#10 = #4003
IF[#24 EQ #0] THEN #24 = 0
IF[#25 EQ #0] THEN #25 = 0
IF[#23 EQ #0] GOTO9101
IF[#11 EQ #0] GOTO9102
IF[#1 EQ #0] GOTO9103
IF[#4 EQ #0] GOTO9104
IF[#23 LE 0] GOTO9105
IF[#11 NE FUP[#11]] GOTO9106
IF[#11 LE 0] GOTO9107
#23 = #23/2
#19 = 1
WHILE[#19 LE #11] DO1
#30 = [#19-1]*#4+#1
X[COS[#30]*#23+#24] Y[SIN[#30]*#23+#25]
#19 = #19+1
END1
GOTO9999
N9101 #3000=101 (NO DIAMETER)
N9102 #3000=102 (NO NUMBER OF HOLES)
N9103 #3000=103 (NO HOLE 1 ANGLE)
N9104 #3000=104 (NO ANGLE INCREMENT)
N9105 #3000=105 (DIA MUST BE GT 0)
N9106 #3000=106 (INTEGER INPUT REQUIRED)
N9107 #3000=107 (ONLY POSITIVE NUMBER)
N9999 G#10
M99
%
