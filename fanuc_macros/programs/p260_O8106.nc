O8106 (ROUGHING CIRCULAR POCKET MACRO)
IF[#7 EQ #0]  GOTO9101
IF[#20 EQ #0] GOTO9102
IF[#23 EQ #0] GOTO9103
IF[#26 EQ #0] GOTO9104
IF[#9 EQ #0] GOTO9105
#10 = #4003
#7 = ABS[#7/2]
#120 = [ABS[#[2400+#20]+#[2600+#20]]]
IF[#120 GE #7] GOTO9106
#26 = ABS[#26]
#126 = #4006
IF[#126 EQ 20.0] THEN #126 = 0.1
IF[#126 EQ 21.0] THEN #126 = 2.0
G90 G00 X#24 Y#25
Z#126
G01 Z0 F[#9/2]
#16 = #26
IF[#6 EQ #0] GOTO1
#6 = ABS[#6]
GOTO2
N0001 #6 = #26
N0002 #4 = #7-#120
WHILE [#16 GE #6] DO1
#33 = #23
G91 G01 Z-#6 F[#9/2]
WHILE [#33 LT #4] DO2
G90 G01 X[#24+#33] F#9
G03 I-#33
#33 = #33+#23
END2
G90 G01 X[#24+#4] F#9
G03 I-#4
G01 X#24 F[#9*3]
#16 = #16-#6
END1
IF[#16 LE 0] GOTO9000
G91 G01 Z-#16 F[#9/2]
#33 = #23
WHILE[#33 LT #4] DO1
G90 G01 X[#24+#33] F#9
G03 I-#33
#33 = #33+#23
END1
G90 G01 X[#24+#4] F#9
G03 I-#4
G01 X#24 F[#9*3]
N9000 G00 Z#126
GOTO9999
N9101 #3000=101 (NO POCKET DIAMETER)
N9102 #3000=102 (NO T-OFFSET)
N9103 #3000=103 (NO CUTTING WIDTH)
N9104 #3000=104 (NO POCKET DEPTH)
N9105 #3000=105 (NO FEEDRATE)
N9106 #3000=106 (TOOL RADIUS TOO LARGE)
N9999 G#10
M99
%
