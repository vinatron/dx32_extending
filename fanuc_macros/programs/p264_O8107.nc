O8107 (CIRCULAR POCKET FINISHING MACRO)
IF[#26 EQ 0] GOTO9101
IF[#23 LE 0] GOTO9102
IF[#20 LE 0] GOTO9103
IF[#20 GT 33] GOTO9104
IF[#9 EQ #0] GOTO9105
#120 = #[2400+#20]+#[2600+#20]
IF[#120 LE 0] GOTO9106
#23 = #23/2
IF[#23 LE #120] GOTO9107
#101 = [#23+#120]/2
#10 = #4003
#26 = ABS[#26]
#126 = #4006
IF[#126 EQ 20.0] THEN #126 = 0.1
IF[#126 EQ 21.0] THEN #126 = 2.0
G90 G00 X#24 Y#25
Z#126
G01 Z-#26 F[#9/2]
G91 G41 X#101 Y[#23-#101] D#20 F#9
G03 X-#101 Y#101 I-#101
J-#23
X-#101 Y-#101 J-#101
G01 G40 X#101 Y-[#23-#101]
G90 G00 Z#126
GOTO9999
N9101 #3000=101 (Z-DEPTH IS ZERO)
N9102 #3000=102 (POCKET DIA ERROR)
N9103 #3000=103 (OFFSET NUMBER ERROR)
N9104 #3000=104 (OFFSET NUMBER TOO BIG)
N9105 #3000=105 (FEEDRATE NOT DEFINED)
N9106 #3000=106 (OFFSET VALUE IS NOT POSITIVE)
N9107 #3000=107 (TOOL OFFSET TOO LARGE)
N9999 G#10
M99
%
