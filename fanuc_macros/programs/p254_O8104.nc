O8104 (BOLT HOLE CIRCLE MACRO)
#10 = #4003
IF[#23 LE 0] GOTO9101
IF[#11 NE FUP[#11]] GOTO9102
IF[#11 LE 0] GOTO9103
IF[#19 EQ #0] THEN #19 = 1
IF[#19 NE FUP[#19]] GOTO9102
IF[#19 LT 1] GOTO9104
IF[#19 GT #11] GOTO9105
#23 = #23/2
WHILE[#19 LE #11] DO1
#30 = [#19-1]*360/#11+#1
X[COS[#30]*#23+#24] Y[SIN[#30]*#23+#25]
#19 = #19+1
END1
GOTO9999
N9101 #3000=101 (DIA MUST BE GT 0)
N9102 #3000=102 (HOLES DATA MUST BE INTEGER)
N9103 #3000=103 (ONLY POSITIVE NUM OF HOLES)
N9104 #3000=104 (START HOLE MUST BE INTEGER)
N9105 #3000=105 (START HOLE NUMBER TOO HIGH)
N9999 G#10
M99
%
