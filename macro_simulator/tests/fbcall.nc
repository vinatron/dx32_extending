O0030 (CALLS: M98 SHARES LOCALS, G65 IN A LOOP, EARLY M99, REPEAT)
G21 G90 G17
#1 = 0
M98 P100 L2
#5 = 0
WHILE [#5 LT 3.] DO1
G65 P200 A[#5 * 10.] B2.
#5 = #5 + 1.
END1
G65 P300 X5. L2
G65 P300 X0
G0 X#1 Y-5.
M30
O0100 (ADD ONE TO THE CALLER'S #1)
#1 = #1 + 1.
M99
O0200 (B HOLES IN A ROW AT X=A)
#3 = 0
WHILE [#3 LT #2] DO1
G0 X#1 Y[#3 * 4.]
#3 = #3 + 1.
END1
M99
O0300 (EARLY RETURN)
G0 X#24 Y20.
IF [#24 LT 1.] GOTO 10
M99
N10 G0 X99. Y99.
M99
